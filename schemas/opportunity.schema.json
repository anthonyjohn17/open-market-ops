{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmarketops.dev/schemas/opportunity.schema.json",
  "title": "Opportunity",
  "description": "Canonical five-step opportunity object (Signal → Spread → Match → Monetize)",
  "type": "object",
  "required": ["meta", "feed", "asset", "trigger", "buyer", "monetization", "scores"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "run_id", "workflow_id", "wedge", "created_at", "framework_complete"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^opp_" },
        "run_id": { "type": "string" },
        "workflow_id": { "type": "string" },
        "workflow_version": { "type": "string" },
        "wedge": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "framework_complete": {
          "type": "boolean",
          "description": "True when buyer and monetization are computed by runtime engines, not workflow stubs"
        }
      }
    },
    "feed": {
      "type": "object",
      "required": ["sources", "evidence"],
      "properties": {
        "sources": { "type": "array", "items": { "type": "string" } },
        "item_count": { "type": "integer", "minimum": 0 },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": { "type": "string" },
              "title": { "type": "string" },
              "posted_at": { "type": "string" }
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "required": ["type", "summary"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "operational_pain_signal",
            "saas_product",
            "domain",
            "local_business",
            "equipment",
            "generic"
          ]
        },
        "summary": { "type": "string" },
        "company": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "domain": { "type": ["string", "null"] }
          }
        },
        "role_cluster": { "type": "string" },
        "hire_count": { "type": "integer", "minimum": 0 },
        "pain_category": { "type": "string" }
      }
    },
    "trigger": {
      "type": "object",
      "required": ["type", "strength", "detected_at", "reasons"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "hiring_surge",
            "urgency_language",
            "closure",
            "rank_decline",
            "founder_burnout",
            "price_drop",
            "domain_expiry",
            "other"
          ]
        },
        "strength": { "type": "string", "enum": ["low", "medium", "high"] },
        "detected_at": { "type": "string", "format": "date-time" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "window_days": { "type": "integer" }
      }
    },
    "buyer": {
      "type": "object",
      "required": ["segments", "source"],
      "properties": {
        "source": { "type": "string", "enum": ["workflow_stub", "buyer_matching_engine"] },
        "segments": { "type": "array", "items": { "type": "string" } },
        "top_buyers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "segment": { "type": "string" },
              "fit_score": { "type": "number", "minimum": 0, "maximum": 1 },
              "rationale": { "type": "string" }
            }
          }
        },
        "buyer_density": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    },
    "monetization": {
      "type": "object",
      "required": ["recommended", "source"],
      "properties": {
        "source": { "type": "string", "enum": ["workflow_stub", "monetization_engine"] },
        "recommended": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["flip", "broker", "retainer", "relaunch", "lead_generation", "data_product"]
          }
        },
        "primary": { "type": "string" },
        "rationale": { "type": "string" },
        "monetization_speed": { "type": "string", "enum": ["slow", "medium", "fast"] }
      }
    },
    "scores": {
      "type": "object",
      "required": ["opportunity_score", "confidence", "eval_version"],
      "properties": {
        "opportunity_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "spread_estimate": {
          "type": "string",
          "enum": ["low", "medium", "medium-high", "high"]
        },
        "urgency": { "type": "string", "enum": ["low", "medium", "high"] },
        "buyer_density": { "type": "string", "enum": ["low", "medium", "high"] },
        "monetization_potential": { "type": "string", "enum": ["low", "medium", "high"] },
        "competition": { "type": "string", "enum": ["low", "medium", "high"] },
        "liquidity_speed": { "type": "string", "enum": ["slow", "medium", "fast"] },
        "eval_version": { "type": "string" }
      }
    },
    "signal": { "$ref": "#/$defs/signalRef" }
  },
  "$defs": {
    "signalRef": {
      "type": "object",
      "description": "Optional embedded signal detail from signal-engine"
    }
  }
}
